# ============================================================================
# NagaEd Software Developer Hurdle Task — Environment Configuration Template
# Copy this file to .env before starting the application:
#   Windows CMD: copy .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nagaed_user
DB_PASSWORD=YourSecureDatabasePassword123!
DB_NAME=nagaed_assessment

# ----------------------------------------------------------------------------
# 2. Backend API Configuration (Node.js / Express)
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_at_least_32_characters
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# ----------------------------------------------------------------------------
# 3. AI Username Microservice (Python FastAPI + Groq Cloud)
# Get a free API key at: https://console.groq.com
# ----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ----------------------------------------------------------------------------
# 4. Frontend Configuration (Browser-Facing URLs)
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000/api

